<UserControl
    x:Class="GitWolf.App.Views.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GitWolf.App.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="14,4,14,10" Spacing="4">
            <TextBlock x:Name="RepoName" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse x:Name="Dot" Width="7" Height="7" VerticalAlignment="Center" />
                <TextBlock x:Name="Summary" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <HyperlinkButton x:Name="Web" Padding="0" FontSize="11.5" Click="OnWeb" ToolTipService.ToolTip="Open on the web">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock x:Name="WebText" MaxWidth="200" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <PathIcon Foreground="{ThemeResource TextFillColorSecondaryBrush}" Data="F1 M0.7,8.35 L8.35,0.7 L9.3,1.65 L1.65,9.3ZM1.85,8.82 L1.65,9.3 L1.17,9.5 L0.7,9.3 L0.5,8.82 L0.7,8.35 L1.17,8.15 L1.65,8.35ZM9.5,1.17 L9.3,1.65 L8.82,1.85 L8.35,1.65 L8.15,1.17 L8.35,0.7 L8.82,0.5 L9.3,0.7ZM2.71,0.5 L8.82,0.5 L8.82,1.85 L2.71,1.85ZM9.5,1.17 L9.5,7.29 L8.15,7.29 L8.15,1.17ZM3.38,1.17 L3.18,1.65 L2.71,1.85 L2.23,1.65 L2.03,1.17 L2.23,0.7 L2.71,0.5 L3.18,0.7ZM9.5,1.17 L9.3,1.65 L8.82,1.85 L8.35,1.65 L8.15,1.17 L8.35,0.7 L8.82,0.5 L9.3,0.7ZM9.5,7.29 L9.3,7.77 L8.82,7.97 L8.35,7.77 L8.15,7.29 L8.35,6.82 L8.82,6.62 L9.3,6.82Z" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>
            </HyperlinkButton>
        </StackPanel>
        <ListView x:Name="Rows" AutomationProperties.Name="Branches, tags and stashes" Grid.Row="1" Padding="4,0,4,8" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="OnClick" DoubleTapped="OnDoubleTap" ContextRequested="OnContext"
                  CanDragItems="True" DragItemsStarting="OnDragStarting" AllowDrop="True"
                  DragOver="OnDragOver" Drop="OnDrop"
                  ContainerContentChanging="OnRow">
            <!-- The stock list transitions take close to a second to show new rows; rows animate themselves. -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <views:SidebarRowView />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
