<UserControl
    x:Class="GitWolf.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid KeyDown="OnKey">
        <Border Background="#66000000" Tapped="OnBackdrop" />
        <Border Width="720" MaxHeight="610" Margin="20,48,20,20" CornerRadius="16" BorderThickness="1"
                Background="{ThemeResource CanvasBrush}" BorderBrush="{ThemeResource PanelBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="6,16" Spacing="8">
                    <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" Margin="14,0,0,8" />
                    <ListView x:Name="Panes" AutomationProperties.Name="Settings sections" SelectionMode="Single" SelectionChanged="OnPane">
                        <x:String>General</x:String>
                        <x:String>Git</x:String>
                        <x:String>Tools</x:String>
                        <x:String>Accounts</x:String>
                        <x:String>Shortcuts</x:String>
                    </ListView>
                </StackPanel>
                <Border Grid.Column="1" Margin="0,10,10,10" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <ScrollViewer x:Name="Scroller">
                            <StackPanel x:Name="Body" Padding="20" Spacing="16" />
                        </ScrollViewer>
                        <Button x:Name="CloseButton" Style="{StaticResource PlainButtonStyle}" Width="32" Height="32"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" Click="OnClose"
                                AutomationProperties.Name="Close settings" ToolTipService.ToolTip="Close (Esc)">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
