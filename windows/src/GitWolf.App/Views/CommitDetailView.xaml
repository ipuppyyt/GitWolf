                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse x:Name="Picture" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="Author" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="Date" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource PillButtonStyle}" Click="OnCopy"
                        ToolTipService.ToolTip="Copy full hash" AutomationProperties.Name="Copy hash">
