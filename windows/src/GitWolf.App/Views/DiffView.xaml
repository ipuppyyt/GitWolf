<UserControl
    x:Class="GitWolf.App.Views.DiffView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GitWolf.App.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="Header" Height="48" Padding="14,0" ColumnSpacing="8" BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource PanelBorderBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <views:FileIconView x:Name="TypeIcon" />
            <TextBlock x:Name="Title" Grid.Column="1" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis">
                <Run x:Name="Folder" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run x:Name="FileName" FontWeight="Bold" />
            </TextBlock>
            <StackPanel x:Name="Tools" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton x:Name="WhitespaceButton" Width="30" Height="26" Padding="0" Click="OnOption"
                              AutomationProperties.Name="Ignore whitespace"
                              ToolTipService.ToolTip="Ignore whitespace (line staging is off while on)">
                    <FontIcon Glyph="&#xE8E4;" FontSize="13" />
                </ToggleButton>
                <ToggleButton x:Name="WholeFileButton" Width="30" Height="26" Padding="0" Click="OnOption"
                              AutomationProperties.Name="Show whole file" ToolTipService.ToolTip="Show whole file">
                    <FontIcon Glyph="&#xE8A5;" FontSize="13" />
                </ToggleButton>
                <Border CornerRadius="7" Padding="2" Background="{ThemeResource PillFillBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="UnifiedButton" Style="{StaticResource PlainButtonStyle}" Width="28" Height="22" CornerRadius="5"
                            Click="OnLayout" AutomationProperties.Name="Unified" ToolTipService.ToolTip="Unified">
                        <Grid>
