<UserControl
    x:Class="GitWolf.App.Views.CommandPaletteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GitWolf.App.Views">

    <Grid>
        <Border Background="#66000000" Tapped="OnBackdrop" />
        <Border Width="580" VerticalAlignment="Top" Margin="0,110,0,0" Style="{StaticResource PanelStyle}">
            <StackPanel>
                <TextBox x:Name="Query" Margin="12" FontSize="15" PlaceholderText="Jump to a repository, branch or action&#x2026;"
                         TextChanged="OnQuery" PreviewKeyDown="OnKey" />
                <ListView x:Name="Results" AutomationProperties.Name="Results" MaxHeight="360" Padding="8,0,8,8" IsItemClickEnabled="True"
                          SelectionMode="Single" ItemClick="OnClick" ContainerContentChanging="OnRow">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="38" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11.5" Opacity="0.6" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
